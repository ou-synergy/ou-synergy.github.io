---
// SIGCSE TS 2027 affiliated event page, served at /sigcse2027.
// Event facts live in the constants below. Edit them here and the page updates.
import Base from '../layouts/Base.astro';
import Avatar from '../components/Avatar.astro';
import { withBase } from '../utils/url';

const EVENT_NAME = 'The First Annual Working Group on Building Entrepreneurship Into Computing Curricula';
const EVENT_DAY = 'Wednesday, February 17, 2027';
// Event day in Sacramento, used for the "days to go" line.
const EVENT_DATE_ISO = '2027-02-17T08:00:00-08:00';
const SIGCSE_URL = 'https://2027.sigcse-ts.acm.org/';
const VENUE_URL = 'https://2027.sigcse-ts.acm.org/venue/sigcse-ts-2027-venue';
const CONTACT_EMAIL = 'zeshili@ou.edu';
// Sponsorship. Set SPONSOR_OPEN to false to hide the whole section once the
// slate is full. Amounts are what a sponsor gets, not what we promise SIGCSE.
const SPONSOR_OPEN = true;
const SPONSOR_EMAIL = 'zeshili@ou.edu';

// Set to '' once SIGCSE accepts the proposal.
const STATUS_NOTE = 'Proposed affiliated event. SIGCSE announces accepted events on November 9, 2026.';

const sections = [
  { id: 'about', label: 'About' },
  { id: 'goals', label: 'Goals' },
  { id: 'agenda', label: 'Agenda' },
  { id: 'attend', label: 'Attend' },
  { id: 'organizers', label: 'Organizers' },
  { id: 'sponsor', label: 'Sponsor' },
  { id: 'venue', label: 'Venue' },
  { id: 'faq', label: 'FAQ' },
];

const facts = [
  { label: 'Date', value: 'Wed, Feb 17, 2027' },
  { label: 'Time', value: '1:00 to 5:00 PM' },
  { label: 'Where', value: 'Sacramento, CA' },
  { label: 'Size', value: '30 to 40 people' },
];

const questions = [
  'Where should entrepreneurship content go relative to core technical courses?',
  'Which teaching models from business schools work inside a computing department?',
  'What keeps these efforts going after the first semester?',
];

const goals = [
  {
    title: 'Map what is taught today',
    body: 'Collect how different schools currently teach entrepreneurship to computing students.',
  },
  {
    title: 'Share course designs',
    body: 'Trade teaching practices, assignments, and course structures across institutions.',
  },
  {
    title: 'Pick research questions',
    body: 'Agree on questions worth studying together across several schools.',
  },
  {
    title: 'Start a SIGCSE community',
    body: 'Decide how this group keeps meeting and working between symposia.',
  },
];


const agenda = [
  {
    at: '1:00',
    mins: 10,
    title: 'Welcome and framing',
    note: 'What a co-produced framework for entrepreneurial curricula could look like, and an introduction to the keynote speaker.',
    kind: 'Facilitated intro',
  },
  {
    at: '1:10',
    mins: 30,
    title: 'Opening keynote: Building the Entrepreneurial University',
    note: 'A leader who has built an entrepreneurial ecosystem inside a research university answers one question: if you were designing a university today to turn technically exceptional computing students into innovators and entrepreneurs, what would you change? Curriculum, culture, mentoring, accelerators, funding, faculty incentives, and institutional barriers are all in scope.',
    kind: 'Keynote',
  },
  {
    at: '1:40',
    mins: 50,
    title: 'Panel: What does it take to turn computing students into builders?',
    note: 'Five panelists: a computing professor who teaches entrepreneurship, a computing professor who has founded companies, a technical founder, an accelerator or startup-ecosystem leader, and a venture investor.',
    kind: 'Panel and Q&A',
  },
  { at: '2:30', mins: 10, title: 'Break', note: 'Informal networking.', kind: 'Break' },
  {
    at: '2:40',
    mins: 50,
    title: 'Parallel working groups: WHERE, WHAT, HOW',
    note: 'WHERE: where entrepreneurship belongs in the computing curriculum, from freshman exposure to capstone, dedicated courses, and graduate programs. WHAT: what students should learn, from opportunity recognition and customer discovery to MVPs, economics, IP, funding, ethics, and failure. HOW: how a program can realistically deliver it, through faculty, entrepreneurs-in-residence, industry mentors, incubators, alumni, competitions, and institutional incentives.',
    kind: 'Small groups',
    hands: true,
  },
  {
    at: '3:30',
    mins: 10,
    title: 'Short break',
    note: 'Groups organize their findings and prepare a report-out.',
    kind: 'Break',
  },
  {
    at: '3:40',
    mins: 45,
    title: 'Working-group reports and cross-group discussion',
    note: 'Each group reports for about ten minutes with five recommendations. The rest of the time goes to the tensions between the WHERE, WHAT, and HOW sets, and to the questions they leave open.',
    kind: 'Report-outs',
    hands: true,
  },
  {
    at: '4:25',
    mins: 25,
    title: 'Synthesis: What would a computing program built on these recommendations look like?',
    note: 'The three outputs go on screen side by side. The organizers lead a live synthesis of where the groups agree, where they do not, and what is left unresolved. The result is a first-draft WHERE-WHAT-HOW framework, and the product of the working group.',
    kind: 'Facilitated synthesis',
    hands: true,
  },
  {
    at: '4:50',
    mins: 10,
    title: 'Closing reflections and next steps',
    note: 'A shared communication channel, and the intent to return to SIGCSE TS 2028 with the framework refined.',
    kind: 'Closing',
  },
];

const audience = [
  {
    title: 'Educators',
    body: 'Faculty and instructors who want material they can use in one class session, a project module, or a full elective. You take the lesson materials home.',
  },
  {
    title: 'Students',
    body: 'Undergraduate and graduate CS and SE students who are curious about startups or want to build products people use.',
  },
  {
    title: 'Software engineers',
    body: 'Practitioners moving toward product or startup roles who want practice with the non-technical side of building software.',
  },
];

const organizers = [
  {
    name: 'Ze Shi (Zane) Li',
    role: 'Organizer',
    affiliation: 'School of Computer Science, University of Oklahoma',
    email: 'zeshili@ou.edu',
    site: withBase('/people/zane'),
    siteLabel: 'ou-synergy.github.io',
    initials: 'ZL',
    avatar: '/people/zane.jpg',
  },
  {
    name: 'Sean Mackay',
    role: 'Organizer',
    affiliation: 'School of Computer Science, University of Oklahoma',
    email: 'snmackay@ou.edu',
    site: 'https://snmackay.github.io/',
    siteLabel: 'snmackay.github.io',
    initials: 'SM',
    avatar: '/photos/sean_photo.jpg',
  },
  {
    name: 'Sridhar Radhakrishnan',
    role: 'Organizer',
    affiliation: 'School of Computer Science, University of Oklahoma',
    email: 'sridhar@ou.edu',
    site: 'https://www.ou.edu/coe/cs/people/faculty/sridhar-radhakrishnan',
    siteLabel: 'ou.edu faculty page',
    initials: 'SR',
    avatar: '/photos/sridhar_photo.png',
    // Tall portrait: crop from the top so his face sits in the circle.
    position: 'center top',
  },
];

const faqs = [
  {
    q: 'Do I need to submit anything?',
    a: 'No. There are no papers or proposals to send. Register for SIGCSE TS 2027 and come.',
  },
  {
    q: 'Do I need to register for SIGCSE TS 2027?',
    a: 'Yes. SIGCSE requires everyone at an affiliated event to be registered for the symposium.',
  },
  {
    q: 'Do I need a business background?',
    a: 'No. Basic familiarity with software development is the only prerequisite.',
  },
  {
    q: 'Can students come?',
    a: 'Yes. Students are one of the three groups this event is designed for.',
  },
  {
    q: 'What time does it start?',
    a: '1:00 PM Pacific on Wednesday, February 17. We finish at 5:00 PM.',
  },
];

const pad = (n: number) => String(n).padStart(2, '0');
---

<Base
  title={`${EVENT_NAME} | SIGCSE TS 2027`}
  description={`${EVENT_NAME}. A half-day SIGCSE TS 2027 affiliated event in Sacramento on February 17, 2027.`}
  currentPage="sigcse"
>
  <!-- Header -->
  <header class="mb-14 sm:mb-16">
    <div class="rise mb-10 flex flex-wrap items-center gap-x-3 gap-y-2 text-[14px] text-tertiary">
      <span class="tag">SIGCSE TS 2027</span>
      <span>Affiliated Event</span>
      <span aria-hidden="true">/</span>
      <span>Sacramento, California</span>
    </div>

    <h1 class="rise title mb-8 font-serif font-normal text-primary" style="--d: 60ms">
      {EVENT_NAME}
    </h1>

    <p class="rise mb-10 max-w-[58ch] text-[19px] leading-relaxed text-secondary sm:text-[21px]" style="--d: 120ms">
      A half-day meeting on teaching entrepreneurship in computing. For educators, students, and
      people from industry.
    </p>

    <div class="rise mb-14 flex flex-wrap items-center gap-x-6 gap-y-4" style="--d: 180ms">
      <a class="btn btn-solid" href={SIGCSE_URL} target="_blank" rel="noopener">
        Register for SIGCSE TS 2027
        <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M7 17 17 7M8 7h9v9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </a>
      <a class="link-quiet" href="#agenda">See the agenda</a>
    </div>

    <dl class="rise facts" style="--d: 240ms">
      {
        facts.map((f) => (
          <div class="fact">
            <dt class="text-[13px] uppercase tracking-[0.14em] text-tertiary">{f.label}</dt>
            <dd class="mt-2 text-[18px] leading-snug text-primary">{f.value}</dd>
          </div>
        ))
      }
    </dl>

    <div class="rise mt-5 flex flex-wrap justify-between gap-x-6 gap-y-1 text-[14px] text-tertiary" style="--d: 300ms">
      {STATUS_NOTE && <p>{STATUS_NOTE}</p>}
      <p class="tabular-nums" data-days-left data-date={EVENT_DATE_ISO} hidden></p>
    </div>
  </header>

  <!-- In-page nav -->
  <nav class="subnav themed sticky z-40 -mx-5 mb-24 border-b-[0.5px] border-hairline bg-page px-5 sm:-mx-8 sm:px-8" aria-label="On this page">
    <ul class="flex gap-6 overflow-x-auto sm:gap-8">
      {
        sections.map((s) => (
          <li class="flex-none">
            <a class="subnav-link" href={`#${s.id}`} data-spy={s.id}>
              {s.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <!-- About -->
  <section id="about" class="block-row anchor">
    <p class="block-label"><span>01</span>About</p>
    <div class="reveal">
      <h2 class="head mb-8">About</h2>
      <p class="max-w-[64ch] text-[19px] leading-relaxed text-secondary">
        A half-day session on teaching entrepreneurship in computing. We will hear from founders,
        work on hands-on activities in small teams, and talk about how to bring this material into
        CS courses.
      </p>

      <div class="mt-12 rounded-2xl border-[0.5px] border-hairline">
        <p class="border-b-[0.5px] border-hairline px-6 py-4 text-[13px] uppercase tracking-[0.14em] text-tertiary sm:px-8">
          Three open questions
        </p>
        <ol>
          {
            questions.map((q, i) => (
              <li class="flex gap-5 border-b-[0.5px] border-hairline px-6 py-5 last:border-b-0 sm:px-8">
                <span class="pt-0.5 text-[14px] tabular-nums text-accent">{pad(i + 1)}</span>
                <span class="text-[18px] leading-snug text-primary">{q}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- Goals -->
  <section id="goals" class="block-row anchor">
    <p class="block-label"><span>02</span>Goals</p>
    <div class="reveal">
      <h2 class="head mb-10">Goals</h2>
      <ul class="grid overflow-hidden rounded-2xl border-[0.5px] border-hairline sm:grid-cols-2">
        {
          goals.map((g, i) => (
            <li class="goal">
              <span class="mb-8 block text-[14px] tabular-nums text-tertiary">{pad(i + 1)}</span>
              <h3 class="mb-2 text-[20px] font-medium leading-snug text-primary">{g.title}</h3>
              <p class="text-[16px] leading-relaxed text-secondary">{g.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Agenda -->
  <section id="agenda" class="block-row anchor">
    <p class="block-label"><span>03</span>Agenda</p>
    <div class="reveal">
      <div class="mb-10 flex flex-wrap items-end justify-between gap-4">
        <h2 class="head">Tentative schedule</h2>
        <p class="text-[15px] text-tertiary">Teams of 6 to 8</p>
      </div>

      <div class="timebar mb-8" aria-hidden="true">
        {
          agenda.map((a) => (
            <span class:list={['seg', a.kind === 'Break' && 'seg-break', a.hands && 'seg-hands']} style={`flex-grow:${a.mins}`}></span>
          ))
        }
      </div>

      <ol class="border-t-[0.5px] border-hairline">
        {
          agenda.map((a) => (
            <li class:list={['agenda-row', a.kind === 'Break' && 'is-break']}>
              <span class="text-[15px] tabular-nums text-tertiary">{a.at}</span>
              <div class="min-w-0">
                <p class="text-[18px] font-medium leading-snug text-primary">{a.title}</p>
                {a.note && <p class="mt-1 text-[16px] leading-relaxed text-secondary">{a.note}</p>}
              </div>
              <div class="agenda-meta">
                <span class:list={['kind', a.hands && 'kind-hands']}>{a.kind}</span>
                <span class="text-[14px] tabular-nums text-tertiary">{a.mins} min</span>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Attend -->
  <section id="attend" class="block-row anchor">
    <p class="block-label"><span>04</span>Attend</p>
    <div class="reveal">
      <h2 class="head mb-4">Who should attend</h2>
      <p class="mb-10 max-w-[60ch] text-[18px] leading-relaxed text-secondary">
        Anyone who is an educator, student, or software engineer.
      </p>
      <ul class="grid gap-4 md:grid-cols-3">
        {
          audience.map((a) => (
            <li class="card themed">
              <h3 class="mb-2 text-[20px] font-medium text-primary">{a.title}</h3>
              <p class="text-[16px] leading-relaxed text-secondary">{a.body}</p>
            </li>
          ))
        }
      </ul>

      <div class="mt-14 grid gap-8 rounded-2xl bg-surface p-7 sm:p-10 md:grid-cols-[1fr_auto] md:items-center">
        <div>
          <h3 class="mb-3 font-serif text-[30px] leading-tight text-primary">How to join</h3>
          <p class="text-[17px] leading-relaxed text-secondary">
            Register for SIGCSE TS 2027.
          </p>
        </div>
        <a class="btn btn-solid justify-self-start" href={SIGCSE_URL} target="_blank" rel="noopener">
          SIGCSE registration
          <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M7 17 17 7M8 7h9v9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Organizers -->
  <section id="organizers" class="block-row anchor">
    <p class="block-label"><span>05</span>Organizers</p>
    <div class="reveal">
      <h2 class="head mb-10">Organizers</h2>
      <ul class="grid gap-4 md:grid-cols-3">
        {
          organizers.map((o) => (
            <li class="card themed flex flex-col">
              <Avatar initials={o.initials} size={72} imagePath={o.avatar} name={o.name} position={o.position} />
              <p class="mt-6 text-[13px] uppercase tracking-[0.14em] text-accent">{o.role}</p>
              <p class="mt-1 text-[21px] font-medium leading-snug text-primary">{o.name}</p>
              <p class="mt-1 text-[15px] leading-snug text-secondary">{o.affiliation}</p>
              <div class="mt-auto flex flex-col gap-1 pt-6 text-[15px]">
                <a class="w-fit text-primary hairline-underline" href={`mailto:${o.email}`}>{o.email}</a>
                <a
                  class="w-fit text-tertiary hover:text-primary"
                  href={o.site}
                  {...(o.site.startsWith('http') ? { target: '_blank', rel: 'noopener' } : {})}
                >
                  {o.siteLabel} ↗
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Sponsors -->
  {
    SPONSOR_OPEN && (
      <section id="sponsor" class="block-row anchor">
        <p class="block-label"><span>06</span>Sponsor</p>
        <div class="reveal">
          <div class="sponsor-banner themed rounded-2xl border-[0.5px] border-hairline px-7 py-9 sm:px-10 sm:py-11">
            <p class="mb-5 inline-flex items-center gap-2.5 text-[13px] font-medium uppercase tracking-[0.14em] text-tertiary">
              <span class="h-1.5 w-1.5 flex-none rounded-full bg-[#EA580C]" aria-hidden="true" />
              Seeking sponsors
            </p>
            <h2 class="mb-5 max-w-[22ch] font-serif text-[30px] font-normal leading-[1.1] tracking-title text-primary sm:text-[38px]">
              Interested in sponsoring?
            </h2>
            <p class="mb-8 max-w-[62ch] text-[18px] leading-relaxed text-secondary">
              We are looking for sponsors for this event. Get in touch.
            </p>
            <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
              <a
                class="btn btn-solid"
                href={`mailto:${SPONSOR_EMAIL}?subject=${encodeURIComponent('Sponsoring the SIGCSE TS 2027 working group')}`}
              >
                Talk to us about sponsoring
              </a>
              <a class="link-quiet" href={`mailto:${SPONSOR_EMAIL}`}>{SPONSOR_EMAIL}</a>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Venue -->
  <section id="venue" class="block-row anchor">
    <p class="block-label"><span>07</span>Venue</p>
    <div class="reveal">
      <h2 class="head mb-10">Venue</h2>
      <p class="mb-2 text-[21px] leading-snug text-primary">SAFE Credit Union Convention Center, Sacramento</p>
      <p class="mb-6 max-w-[64ch] text-[17px] leading-relaxed text-secondary">
        The event runs at the SIGCSE TS 2027 venue on Wednesday, February 17. We will post the room
        once SIGCSE assigns it.
      </p>
      <a class="link-quiet" href={VENUE_URL} target="_blank" rel="noopener">Venue and hotel details ↗</a>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="block-row anchor">
    <p class="block-label"><span>08</span>FAQ</p>
    <div class="reveal">
      <h2 class="head mb-8">Questions</h2>
      <dl class="grid gap-x-12 gap-y-8 md:grid-cols-2">
        {
          faqs.map((f) => (
            <div>
              <dt class="mb-1.5 text-[18px] font-medium leading-snug text-primary">{f.q}</dt>
              <dd class="text-[17px] leading-relaxed text-secondary">{f.a}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-10 text-[16px] text-tertiary">
        Anything else, email
        <a class="text-primary hairline-underline" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>
    </div>
  </section>

  <!-- Closing -->
  <section class="mb-10 border-t-[0.5px] border-hairline pt-16 sm:pt-20">
    <div class="reveal flex flex-wrap items-end justify-between gap-8">
      <h2 class="max-w-[16ch] font-serif text-[40px] font-normal leading-[1.05] tracking-title text-primary sm:text-[56px]">
        Register for SIGCSE TS 2027
      </h2>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-4">
        <a class="btn btn-solid" href={SIGCSE_URL} target="_blank" rel="noopener">SIGCSE registration</a>
        <a class="link-quiet" href={`mailto:${CONTACT_EMAIL}`}>Email the organizers</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .text-accent {
    color: #ea580c;
  }

  /* Sponsor call-out: one soft orange wash so it reads as a banner rather
     than another content card. */
  .sponsor-banner {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .sponsor-banner::before {
    content: '';
    position: absolute;
    inset: -40%;
    z-index: -1;
    background: radial-gradient(40% 50% at 16% 26%, rgba(234, 88, 12, 0.16), transparent 70%);
    pointer-events: none;
  }

  .tag {
    border-radius: 6px;
    background: var(--color-text-primary);
    color: var(--color-page);
    padding: 3px 9px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  .title {
    font-size: clamp(30px, 3.4vw, 46px);
    line-height: 1.08;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .head {
    max-width: 26ch;
    font-family: Newsreader, Georgia, serif;
    font-size: clamp(28px, 3.4vw, 42px);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
  }

  /* Key facts strip under the title. */
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 0.5px solid var(--color-text-primary);
    border-bottom: 0.5px solid var(--color-hairline);
  }
  .fact {
    padding: 18px 16px 20px 0;
  }
  .fact:nth-child(n + 3) {
    border-top: 0.5px solid var(--color-hairline);
  }
  @media (min-width: 768px) {
    .facts {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .fact {
      padding: 20px 20px 24px 0;
    }
    .fact + .fact {
      border-left: 0.5px solid var(--color-hairline);
      padding-left: 20px;
    }
    .fact:nth-child(n + 3) {
      border-top: 0;
    }
  }

  /* Buttons and links */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border-radius: 999px;
    padding: 12px 22px;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.2;
    transition: opacity 0.2s ease;
  }
  .btn-solid {
    background: var(--color-text-primary);
    color: var(--color-page);
  }
  .btn-solid:hover {
    opacity: 0.85;
  }
  .arrow {
    transition: transform 0.2s ease;
  }
  .btn:hover .arrow {
    transform: translate(2px, -2px);
  }
  .link-quiet {
    font-size: 16px;
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-color: var(--color-hairline);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition: text-decoration-color 0.2s ease;
  }
  .link-quiet:hover {
    text-decoration-color: var(--color-text-primary);
  }

  /* Sticky section nav, placed under the site header. */
  .subnav {
    top: var(--site-header-h, 64px);
  }
  .subnav ul {
    scrollbar-width: none;
  }
  .subnav ul::-webkit-scrollbar {
    display: none;
  }
  .subnav-link {
    display: block;
    border-bottom: 1.5px solid transparent;
    padding: 14px 0 12px;
    font-size: 15px;
    color: var(--color-text-tertiary);
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .subnav-link:hover {
    color: var(--color-text-primary);
  }
  .subnav-link.is-active {
    border-bottom-color: var(--color-text-primary);
    color: var(--color-text-primary);
  }
  .anchor {
    scroll-margin-top: calc(var(--site-header-h, 64px) + 80px);
  }

  /* Section layout: small numbered label on the left, content on the right. */
  .block-row {
    display: grid;
    gap: 20px;
    margin-bottom: 112px;
  }
  .block-label {
    display: flex;
    gap: 10px;
    font-size: 14px;
    color: var(--color-text-secondary);
  }
  .block-label span {
    color: var(--color-text-tertiary);
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 1024px) {
    .block-row {
      grid-template-columns: 200px minmax(0, 1fr);
      gap: 48px;
      margin-bottom: 140px;
    }
    .block-label {
      position: sticky;
      top: calc(var(--site-header-h, 64px) + 90px);
      align-self: start;
      padding-top: 10px;
    }
  }

  .goal {
    padding: 28px;
    border-bottom: 0.5px solid var(--color-hairline);
    transition: background-color 0.2s ease;
  }
  .goal:hover {
    background: var(--color-surface);
  }
  .goal:last-child {
    border-bottom: 0;
  }
  @media (min-width: 640px) {
    .goal {
      padding: 32px;
    }
    .goal:nth-child(odd) {
      border-right: 0.5px solid var(--color-hairline);
    }
    .goal:nth-last-child(-n + 2) {
      border-bottom: 0;
    }
  }

  /* Agenda: proportional bar, then rows. */
  .timebar {
    display: flex;
    gap: 3px;
    height: 8px;
  }
  .seg {
    flex-basis: 0;
    border-radius: 2px;
    background: var(--color-text-primary);
  }
  .seg-hands {
    background: #ea580c;
  }
  .seg-break {
    background: var(--color-hairline);
  }
  .agenda-row {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 4px 16px;
    border-bottom: 0.5px solid var(--color-hairline);
    padding: 20px 0;
  }
  .agenda-row > span:first-child {
    padding-top: 2px;
  }
  .agenda-meta {
    grid-column: 2;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
  }
  .agenda-row.is-break p {
    color: var(--color-text-tertiary);
    font-weight: 400;
  }
  @media (min-width: 768px) {
    .agenda-row {
      grid-template-columns: 72px minmax(0, 1fr) 190px;
      gap: 24px;
    }
    .agenda-meta {
      grid-column: 3;
      justify-content: flex-end;
      margin-top: 0;
      padding-top: 2px;
      align-self: start;
    }
  }
  .kind {
    border-radius: 999px;
    border: 0.5px solid var(--color-hairline);
    padding: 2px 10px;
    font-size: 13px;
    color: var(--color-text-secondary);
  }
  .kind-hands {
    border-color: rgba(234, 88, 12, 0.45);
    color: #ea580c;
  }

  .card {
    border-radius: 18px;
    border: 0.5px solid var(--color-hairline);
    padding: 28px;
    transition: border-color 0.2s ease;
  }
  .card:hover {
    border-color: var(--color-text-tertiary);
  }

  /* Motion, only when the visitor allows it. Content stays visible without JS. */
  @media (prefers-reduced-motion: no-preference) {
    .rise {
      animation: rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: var(--d, 0ms);
    }
    :global(html.reveal-ready) .reveal {
      opacity: 0;
      transform: translateY(16px);
      transition: opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1), transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    }
    :global(html.reveal-ready) .reveal.is-in {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  // Keep the section nav just below the sticky site header.
  const header = document.querySelector('body > header');
  const setHeaderHeight = () => {
    if (header) {
      document.documentElement.style.setProperty('--site-header-h', `${header.getBoundingClientRect().height}px`);
    }
  };
  setHeaderHeight();
  window.addEventListener('resize', setHeaderHeight);

  const today = new Date();
  today.setHours(0, 0, 0, 0);

  // "N days to go" line.
  const daysLeft = document.querySelector<HTMLElement>('[data-days-left]');
  if (daysLeft) {
    const eventDay = new Date(daysLeft.dataset.date ?? '');
    eventDay.setHours(0, 0, 0, 0);
    const days = Math.round((eventDay.getTime() - today.getTime()) / 86400000);
    if (days > 1) daysLeft.textContent = `${days} days to go`;
    else if (days === 1) daysLeft.textContent = 'Tomorrow';
    else if (days === 0) daysLeft.textContent = 'Today';
    if (days >= 0) daysLeft.hidden = false;
  }

  // Highlight the section nav link for the section in view.
  const links = new Map<string, HTMLElement>();
  for (const a of document.querySelectorAll<HTMLElement>('[data-spy]')) {
    links.set(a.dataset.spy ?? '', a);
  }
  const spy = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const a of links.values()) a.classList.remove('is-active');
        const active = links.get(entry.target.id);
        if (!active) continue;
        active.classList.add('is-active');
        // On narrow screens the link row scrolls sideways; keep the active link in view.
        const row = active.closest('ul');
        if (row && row.scrollWidth > row.clientWidth) {
          row.scrollLeft = active.offsetLeft - row.clientWidth / 2 + active.offsetWidth / 2;
        }
      }
    },
    { rootMargin: '-35% 0px -60% 0px' },
  );
  for (const id of links.keys()) {
    const section = document.getElementById(id);
    if (section) spy.observe(section);
  }

  // Fade sections in as they scroll into view.
  if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    document.documentElement.classList.add('reveal-ready');
    const reveal = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-in');
            reveal.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -8% 0px' },
    );
    for (const el of document.querySelectorAll('.reveal')) reveal.observe(el);
  }
</script>
