---
import Base from '../../layouts/Base.astro';
import PaperItem from '../../components/PaperItem.astro';
import AreaIcon from '../../components/AreaIcon.astro';
import { orderedAreas, allPapers, publicationYears } from '../../utils/queries';

const areas = await orderedAreas();
const years = await publicationYears();
// Default view is a single flat list of every paper, newest first. Filtering is
// done client-side by toggling visibility; nothing is re-fetched.
const papers = await allPapers();
// Papers are grouped under a year heading. `years` is already newest-first, so
// the groups come out in the same order; the filter JS hides a heading when
// none of its papers survive the current filter.
const grouped = years.map((year) => ({
  year,
  papers: papers.filter((paper) => paper.data.year === year),
}));

const pad = (n: number) => String(n).padStart(2, '0');
---

<Base
  title="Research — Synergy Lab"
  description="What we work on: research areas and the lab's publications, newest first."
  currentPage="research"
>
  <!-- Intro -->
  <section class="mb-12">
    <p class="label">Research</p>
    <h1
      class="mt-3 max-w-[900px] font-serif text-[40px] font-normal leading-[1.12] tracking-hero text-primary sm:text-[52px]"
    >
      What we work on.
    </h1>
    <p class="mt-5 max-w-[860px] text-[19px] leading-relaxed text-secondary">
      Six areas, listed below with every paper the lab has published, newest first. Pick an
      area to read about it and narrow the list to its papers.
    </p>
  </section>

  <!-- Filters -->
  <section class="mb-10 border-b-[0.5px] border-hairline pb-10">
    <p class="label mb-3">Area</p>
    <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by area">
      <button class="pill" data-area-filter="all" aria-pressed="true">All</button>
      {
        areas.map((area) => (
          <button class="pill inline-flex items-center gap-2" data-area-filter={area.slug} aria-pressed="false">
            <AreaIcon slug={area.slug} size={16} />
            {area.data.short_title ?? area.data.title}
          </button>
        ))
      }
    </div>

    <p class="mt-7 text-[16px] text-secondary">
      <span class="mr-4 text-tertiary">Year</span>
      <a class="year-link" href="#" data-year-filter="all" aria-current="true">All</a>
      {
        years.map((year) => (
          <>
            <span class="text-tertiary"> · </span>
            <a class="year-link" href="#" data-year-filter={String(year)}>
              {year}
            </a>
          </>
        ))
      }
    </p>
  </section>

  <!-- Area info panels: shown only when that area is selected -->
  <div>
    {
      areas.map((area) => (
        <section class="mb-10" data-area-panel={area.slug} hidden>
          <div class="flex items-start gap-4">
            <span class="flex h-12 w-12 flex-none items-center justify-center rounded-xl bg-surface text-primary">
              <AreaIcon slug={area.slug} size={26} />
            </span>
            <div>
              <span class="text-[15px] tabular-nums text-tertiary">{pad(area.data.order)}</span>
              <h2 class="text-[28px] font-medium leading-tight text-primary">{area.data.title}</h2>
            </div>
          </div>
          <p
            class="prose mt-4 max-w-[860px] text-[18px] leading-relaxed text-secondary"
            set:html={area.data.full_description}
          />
        </section>
      ))
    }
  </div>

  <!-- Publications -->
  <section>
    <p class="label mb-6" data-results-label>All publications, newest first</p>
    {
      grouped.map((group) => (
        <section class="mb-11" data-year-group={group.year}>
          <h2 class="mb-5 flex items-baseline gap-4 text-[15px] tabular-nums text-tertiary">
            <span>{group.year}</span>
            <span class="h-px flex-1 bg-hairline" aria-hidden="true" />
          </h2>
          <div class="flex flex-col gap-7">
            {group.papers.map((paper) => <PaperItem paper={paper} />)}
          </div>
        </section>
      ))
    }
    <p class="mt-2 text-[16px] italic text-tertiary" data-no-results hidden>
      No publications match the current filter.
    </p>
  </section>
</Base>

<script>
  // Vanilla filtering — no framework. Show the selected area's info panel and
  // narrow the flat publication list by area + year.
  const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-area-filter]'));
  const yearLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-year-filter]'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-area-panel]'));
  const papers = Array.from(document.querySelectorAll<HTMLElement>('.paper'));
  const yearGroups = Array.from(document.querySelectorAll<HTMLElement>('[data-year-group]'));
  const noResults = document.querySelector<HTMLElement>('[data-no-results]');
  const resultsLabel = document.querySelector<HTMLElement>('[data-results-label]');

  let areaFilter = 'all';
  let yearFilter = 'all';

  function labelForArea(slug: string): string {
    const pill = pills.find((p) => p.dataset.areaFilter === slug);
    return pill ? pill.textContent?.trim() ?? '' : '';
  }

  function apply() {
    // Show the active area's panel (none when "All").
    for (const panel of panels) {
      panel.hidden = panel.dataset.areaPanel !== areaFilter;
    }

    let visible = 0;
    for (const paper of papers) {
      const paperAreas = (paper.dataset.areas ?? '').split(' ').filter(Boolean);
      const paperYear = paper.dataset.year ?? '';
      const areaOk = areaFilter === 'all' || paperAreas.includes(areaFilter);
      const yearOk = yearFilter === 'all' || paperYear === yearFilter;
      const show = areaOk && yearOk;
      paper.classList.toggle('is-hidden', !show);
      if (show) visible += 1;
    }

    // A year heading is only meaningful if something is left under it.
    for (const group of yearGroups) {
      const shown = Array.from(group.querySelectorAll<HTMLElement>('.paper'));
      group.hidden = shown.every((paper) => paper.classList.contains('is-hidden'));
    }

    if (noResults) noResults.hidden = visible !== 0;

    if (resultsLabel) {
      const scope =
        areaFilter === 'all' ? 'All publications' : `${labelForArea(areaFilter)} publications`;
      const yearText = yearFilter === 'all' ? ', newest first' : ` from ${yearFilter}`;
      resultsLabel.textContent = visible === 0 ? '' : `${scope}${yearText}`;
    }
  }

  for (const pill of pills) {
    pill.addEventListener('click', () => {
      areaFilter = pill.dataset.areaFilter ?? 'all';
      for (const p of pills) p.setAttribute('aria-pressed', String(p === pill));
      apply();
    });
  }

  for (const link of yearLinks) {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      yearFilter = link.dataset.yearFilter ?? 'all';
      for (const l of yearLinks) {
        if (l === link) l.setAttribute('aria-current', 'true');
        else l.removeAttribute('aria-current');
      }
      apply();
    });
  }

  apply();
</script>
