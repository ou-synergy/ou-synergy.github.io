---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import DeadlineRow, { type DatedDeadline } from '../components/DeadlineRow.astro';
import DeadlineTitle from '../components/DeadlineTitle.astro';
import { CORE_RANKS } from '../utils/deadlines';

// Every YAML file in src/content/deadlines/ adds to the same list.
const items = (await getCollection('deadlines')).flatMap((file) => file.data);

// Sorted here for readers without JavaScript. The script at the bottom does
// the same sort in the browser, so the order stays right between rebuilds.
const now = Date.now();
const YEAR = 365.2425 * 86_400_000;

const dated = items.filter((item): item is DatedDeadline => item.deadline !== undefined);
const nextUp = (item: DatedDeadline) =>
  item.abstract && item.abstract.at > now ? item.abstract.at : item.deadline.at;
const upcoming = dated
  .filter((item) => item.deadline.at > now)
  .sort((a, b) => nextUp(a) - nextUp(b));
const passed = dated
  .filter((item) => item.deadline.at <= now)
  .sort((a, b) => b.deadline.at - a.deadline.at);

// Not announced yet: soonest expected first, going by last year's date.
const untilAnniversary = (at: number) => (((at - now) % YEAR) + YEAR) % YEAR;
const tba = items
  .filter((item) => item.deadline === undefined && !item.rolling)
  .sort((a, b) => {
    if (a.last_year && b.last_year) {
      return untilAnniversary(a.last_year.at) - untilAnniversary(b.last_year.at);
    }
    if (a.last_year) return -1;
    if (b.last_year) return 1;
    return a.name.localeCompare(b.name);
  });
const rolling = items
  .filter((item) => item.rolling)
  .sort((a, b) => a.name.localeCompare(b.name));

// Conferences with no date to count down to share one row layout.
const undated = [
  { list: 'tba', title: 'Not announced yet', label: 'TBA', items: tba },
  { list: 'rolling', title: 'Rolling submissions', label: 'Any time', items: rolling },
].filter((group) => group.items.length > 0);

// Area buttons come from the tags the list uses, most used first.
const tagCounts = new Map<string, { label: string; count: number }>();
for (const item of items) {
  for (const tag of item.tags) {
    const key = tag.toLowerCase();
    const entry = tagCounts.get(key) ?? { label: tag, count: 0 };
    entry.count += 1;
    tagCounts.set(key, entry);
  }
}
const areaOptions = Array.from(tagCounts, ([value, { label, count }]) => ({ value, label, count }))
  .sort((a, b) => b.count - a.count);

// Rank buttons: A* and A always, since the list keeps to those. Any other
// CORE rank gets a button only if the file uses it, and so do unranked ones.
const rankOptions = CORE_RANKS.filter(
  (rank) => ['A*', 'A'].includes(rank) || items.some((item) => item.core === rank),
).map((rank) => ({ value: rank, label: rank }));
if (items.some((item) => !item.core)) {
  rankOptions.push({ value: 'none', label: 'No rank' });
}

const filterGroups = [
  { key: 'area', label: 'Area', options: areaOptions.length > 1 ? areaOptions : [] },
  { key: 'core', label: 'CORE rank', options: rankOptions },
].filter((group) => group.options.length > 0);
---

<Base
  title="Deadlines | Synergy Lab"
  description="Paper deadlines for the conferences the Synergy Lab submits to, with countdowns."
>
  <section class="mb-12">
    <p class="label">Deadlines</p>
    <h1
      class="mt-3 max-w-[900px] font-serif text-[40px] font-normal leading-[1.12] tracking-hero text-primary sm:text-[52px]"
    >
      Conference deadlines.
    </h1>
    <p class="mt-5 max-w-[860px] text-[19px] leading-relaxed text-secondary">
      Paper deadlines for the venues we submit to in software engineering, information systems,
      HCI, AI, computing education, and health. Times are Anywhere on Earth (UTC-12) unless marked
      otherwise. Check the conference's call for papers before you plan around a date.
    </p>
  </section>

  {
    filterGroups.length > 0 && (
      <section class="mb-10 flex flex-col gap-7 border-b-[0.5px] border-hairline pb-10">
        {filterGroups.map((group) => (
          <div>
            <p class="label mb-3">
              {group.key === 'core' ? (
                <>
                  <a href="https://portal.core.edu.au/conf-ranks/" class="hairline-underline">
                    CORE
                  </a>{' '}
                  rank
                </>
              ) : (
                group.label
              )}
            </p>
            <div class="flex flex-wrap gap-2" role="group" aria-label={`Filter by ${group.label}`}>
              <button
                class="pill"
                data-filter-group={group.key}
                data-filter-value="all"
                aria-pressed="true"
              >
                All
              </button>
              {group.options.map((option) => (
                <button
                  class="pill"
                  data-filter-group={group.key}
                  data-filter-value={option.value}
                  aria-pressed="false"
                >
                  {option.label}
                </button>
              ))}
            </div>
          </div>
        ))}
      </section>
    )
  }

  <section class="mb-16">
    <h2 class="section-head mb-3">Upcoming</h2>
    <ol data-list="upcoming">
      {upcoming.map((item) => <DeadlineRow item={item} />)}
    </ol>
    <p
      class="border-t-[0.5px] border-hairline pt-6 text-[16px] italic text-tertiary"
      data-empty
      hidden={upcoming.length > 0}
    >
      No upcoming deadlines to show.
    </p>
  </section>

  {
    undated.map((group) => (
      <section class="mb-16" data-undated-section>
        <h2 class="section-head mb-3">{group.title}</h2>
        <ul data-list={group.list}>
          {group.items.map((item) => {
            const details = [item.where, item.when].filter(Boolean).join(' · ');
            return (
              <li
                class="undated grid gap-x-8 gap-y-1 border-t-[0.5px] border-hairline py-5 sm:grid-cols-[10rem_minmax(0,1fr)] lg:grid-cols-[11rem_minmax(0,1fr)_auto]"
                data-undated
                data-tags={JSON.stringify(item.tags)}
                data-core={item.core}
                data-last={item.last_year?.at}
              >
                <p class="text-[16px] leading-snug text-tertiary">{group.label}</p>
                <div class="min-w-0">
                  <DeadlineTitle
                    name={item.name}
                    link={item.link}
                    core={item.core}
                    tags={item.tags}
                    size="small"
                  />
                  {item.full && <p class="mt-1 text-[16px] leading-snug text-secondary">{item.full}</p>}
                  {details && <p class="mt-1 text-[15px] leading-snug text-tertiary">{details}</p>}
                  {item.note && <p class="mt-1 text-[15px] leading-snug text-tertiary">{item.note}</p>}
                </div>
                <p class="text-[15px] leading-snug text-tertiary sm:col-start-2 lg:col-start-auto lg:text-right">
                  {item.last_year && `Last year: ${item.last_year.day}`}
                </p>
              </li>
            );
          })}
        </ul>
      </section>
    ))
  }

  <section data-passed-section hidden={passed.length === 0}>
    <details>
      <summary class="section-head cursor-pointer">
        Passed <span class="font-normal text-tertiary" data-passed-count>({passed.length})</span>
      </summary>
      <ol class="mt-3" data-list="passed">
        {passed.map((item) => <DeadlineRow item={item} />)}
      </ol>
    </details>
  </section>
</Base>

<style>
  .undated.is-filtered {
    display: none;
  }
</style>

<script>
  import { formatLeft } from '../utils/deadlines';

  const DAY = 86_400_000;
  const YEAR = 365.2425 * DAY;

  const upcomingList = document.querySelector<HTMLElement>('[data-list="upcoming"]');
  const passedList = document.querySelector<HTMLElement>('[data-list="passed"]');
  const tbaList = document.querySelector<HTMLElement>('[data-list="tba"]');
  const emptyNote = document.querySelector<HTMLElement>('[data-empty]');
  const passedSection = document.querySelector<HTMLElement>('[data-passed-section]');
  const passedCount = document.querySelector<HTMLElement>('[data-passed-count]');
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-deadline]'));
  const undatedSections = Array.from(
    document.querySelectorAll<HTMLElement>('[data-undated-section]'),
  );
  const tbaRows = tbaList ? Array.from(tbaList.querySelectorAll<HTMLElement>('[data-undated]')) : [];
  const pills = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter-group]'));

  // The viewer's own zone and locale, e.g. "Sun, Mar 14, 6:59 AM".
  const localTime = new Intl.DateTimeFormat(undefined, {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
  });

  // What is picked in each filter group. An empty set means "All". Within a
  // group, a row needs to match any one pick; across groups, it must match both.
  const picked = new Map<string, Set<string>>();
  for (const pill of pills) picked.set(pill.dataset.filterGroup ?? '', new Set());

  function matches(el: HTMLElement): boolean {
    const areas = picked.get('area');
    if (areas && areas.size > 0) {
      let tags: string[] = [];
      try {
        tags = JSON.parse(el.dataset.tags ?? '[]') as string[];
      } catch {
        // Unreadable tags count as no tags.
      }
      if (!tags.some((tag) => areas.has(tag.toLowerCase()))) return false;
    }
    const ranks = picked.get('core');
    if (ranks && ranks.size > 0 && !ranks.has(el.dataset.core ?? 'none')) return false;
    return true;
  }

  // Put `items` into `list` in this order. Skips the DOM when nothing moved,
  // so a reader's text selection survives the 30-second refresh.
  function place(list: HTMLElement | null, items: HTMLElement[]) {
    if (!list) return;
    const current = Array.from(list.children);
    if (current.length === items.length && items.every((el, i) => current[i] === el)) return;
    list.append(...items);
  }

  function update() {
    const now = Date.now();
    const upcoming: { el: HTMLElement; at: number }[] = [];
    const passed: { el: HTMLElement; at: number }[] = [];

    for (const row of rows) {
      const paper = Number(row.dataset.paper);
      const abstract = row.dataset.abstract ? Number(row.dataset.abstract) : null;
      const left = row.querySelector<HTMLElement>('[data-left]');
      const detail = row.querySelector<HTMLElement>('[data-left-detail]');

      for (const el of row.querySelectorAll('[data-date="abstract"]')) {
        el.classList.toggle('is-past', abstract !== null && abstract <= now);
      }

      if (paper <= now) {
        row.classList.add('is-passed');
        row.classList.remove('is-soon');
        if (left) left.textContent = 'Closed';
        if (detail) detail.textContent = '';
        passed.push({ el: row, at: paper });
      } else {
        const toAbstract = abstract !== null && abstract > now;
        const next = toAbstract ? abstract : paper;
        row.classList.remove('is-passed');
        // Under 8 days, so every row that reads "7 days" or less gets the dot.
        row.classList.toggle('is-soon', next - now < 8 * DAY);
        if (left) left.textContent = formatLeft(next - now);
        if (detail) {
          const which = abstract === null ? '' : toAbstract ? 'Abstract due ' : 'Paper due ';
          detail.textContent = `${which}${localTime.format(next)} your time`;
        }
        upcoming.push({ el: row, at: next });
      }

      row.classList.toggle('is-filtered', !matches(row));
    }

    upcoming.sort((a, b) => a.at - b.at);
    passed.sort((a, b) => b.at - a.at);
    place(upcomingList, upcoming.map((item) => item.el));
    place(passedList, passed.map((item) => item.el));

    const visible = (el: HTMLElement) => !el.classList.contains('is-filtered');
    if (emptyNote) emptyNote.hidden = upcoming.some((item) => visible(item.el));

    const passedVisible = passed.filter((item) => visible(item.el)).length;
    if (passedSection) passedSection.hidden = passedVisible === 0;
    if (passedCount) passedCount.textContent = `(${passedVisible})`;

    // Not announced yet: soonest expected first, going by last year's date.
    // Rows without last_year keep their place at the end.
    const untilAnniversary = (el: HTMLElement) =>
      el.dataset.last
        ? (((Number(el.dataset.last) - now) % YEAR) + YEAR) % YEAR
        : Number.MAX_SAFE_INTEGER;
    place(
      tbaList,
      [...tbaRows].sort((a, b) => untilAnniversary(a) - untilAnniversary(b)),
    );

    for (const section of undatedSections) {
      const sectionRows = Array.from(section.querySelectorAll<HTMLElement>('[data-undated]'));
      for (const row of sectionRows) row.classList.toggle('is-filtered', !matches(row));
      section.hidden = !sectionRows.some(visible);
    }
  }

  // Each button toggles its value; "All" clears the group.
  for (const pill of pills) {
    pill.addEventListener('click', () => {
      const group = pill.dataset.filterGroup ?? '';
      const value = pill.dataset.filterValue ?? 'all';
      const set = picked.get(group);
      if (!set) return;
      if (value === 'all') set.clear();
      else if (set.has(value)) set.delete(value);
      else set.add(value);
      for (const p of pills) {
        if (p.dataset.filterGroup !== group) continue;
        const v = p.dataset.filterValue ?? 'all';
        p.setAttribute('aria-pressed', String(v === 'all' ? set.size === 0 : set.has(v)));
      }
      update();
    });
  }

  update();
  setInterval(update, 30_000);
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'visible') update();
  });
</script>
