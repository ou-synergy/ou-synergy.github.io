---
// Simple monochrome line icon per research area, keyed by slug. Uses
// currentColor so it inherits the surrounding text color and stays on-palette.
// Falls back to a neutral dot for unknown slugs.
export interface Props {
  slug: string;
  size?: number;
}

const { slug, size = 24 } = Astro.props;

const paths: Record<string, string> = {
  // AI for software engineering — code brackets with a spark
  'ai-for-software-engineering':
    '<path d="M8.5 7 4 12l4.5 5"/><path d="M15.5 7 20 12l-4.5 5"/><path d="M13.2 6.5 10.8 17.5"/>',
  // Human–AI collaboration — a person and a machine node, connected
  'human-ai-collaboration':
    '<circle cx="6.5" cy="7.5" r="2.75"/><path d="M2.5 19c0-2.6 1.8-4 4-4s4 1.4 4 4"/><rect x="14" y="6" width="7.5" height="7.5" rx="1.75"/><path d="M17.75 13.5V19h-7"/>',
  // Requirements engineering — speech bubbles
  'requirements-engineering':
    '<path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h10A1.5 1.5 0 0 1 16 6.5v5A1.5 1.5 0 0 1 14.5 13H8l-3.5 3v-3A1.5 1.5 0 0 1 3 11.5Z"/><path d="M18.5 9H20a1 1 0 0 1 1 1v5.5a1 1 0 0 1-1 1h-.5V20l-3-3.5"/>',
  // Privacy, compliance & continuous SE — shield with a check
  'privacy-compliance':
    '<path d="M12 3l7 3v5c0 4.8-3.3 7.9-7 9-3.7-1.1-7-4.2-7-9V6l7-3Z"/><path d="m9 12 2 2 4-4"/>',
  // Data mining & empirical methods — scatter with a trend line
  'data-mining-empirical':
    '<path d="M3 3v18h18"/><path d="m7 16 4-4 3 2 5-6"/><circle cx="7" cy="16" r="1.1"/><circle cx="11" cy="12" r="1.1"/><circle cx="14" cy="14" r="1.1"/><circle cx="19" cy="8" r="1.1"/>',
  // Computing education — graduation cap
  'computing-education':
    '<path d="M12 4 2.5 8.5 12 13l9.5-4.5L12 4Z"/><path d="M6.5 10.8v4.4c0 1.5 2.5 2.8 5.5 2.8s5.5-1.3 5.5-2.8v-4.4"/><path d="M21.5 8.5v5"/>',
};

const fallback = '<circle cx="12" cy="12" r="3.5"/>';
const inner = paths[slug] ?? fallback;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={inner}
></svg>
