---
// Site footer: location of the group + quick links, mirroring the nav.
// Address and contact are seed placeholders — edit them here.
import { withBase } from '../utils/url';
import Logo from './Logo.astro';

const quickLinks = [
  { label: 'Home', href: withBase('/') },
  { label: 'Research', href: withBase('/research') },
  { label: 'People', href: withBase('/people') },
  { label: 'Join our lab', href: withBase('/join') },
];

const contactEmail = 'zeshili@ou.edu';
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t-[0.5px] border-hairline pb-12 pt-10">
  <div class="flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between">
    <div class="max-w-sm">
      <a href={withBase('/')} class="inline-flex items-center" aria-label="Synergy Lab — home">
        <Logo variant="nav" />
      </a>
      <address class="mt-4 text-[16px] not-italic leading-relaxed text-secondary">
        School of Computer Science<br />
        University of Oklahoma<br />
        Norman, Oklahoma
      </address>
      <a
        href={`mailto:${contactEmail}`}
        class="mt-3 inline-block text-[16px] text-primary hairline-underline"
      >
        {contactEmail}
      </a>
    </div>

    <nav class="shrink-0" aria-label="Footer">
      <p class="label mb-3">Site</p>
      <ul class="flex flex-col gap-2.5">
        {
          quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-[16px] text-secondary hover:text-primary">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <p class="mt-12 text-[14px] text-tertiary">
    © {year} Synergy Lab · School of Computer Science, University of Oklahoma
  </p>
</footer>
